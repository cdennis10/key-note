{
  "name": "piano-note-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
